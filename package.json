{
  "name": "lightshare",
  "version": "1.0.0",
  "description": "LightShare V1.0 - High-Speed 30GB+ Local & Hotspot File Transfer App",
  "main": "electron-main.js",
  "author": "Tanmaya Mahapatra (Retired AME) <dronalabs.support@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:all": "electron-builder -wml",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac --arm64",
    "cap:sync": "cap sync",
    "cap:android": "cap add android && cap sync android",
    "cap:ios": "cap add ios && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lightshare.transfer.app",
    "productName": "LightShare",
    "copyright": "Copyright © 2026 Tanmaya Mahapatra (Retired AME)",
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "app/main.py",
      "app/config.py",
      "app/database/**/*",
      "app/static/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32", "arm64"]
        },
        {
          "target": "portable",
          "arch": ["x64", "ia32"]
        }
      ],
      "icon": "app/static/icon.ico",
      "artifactName": "LightShare-Windows-${target}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LightShare"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64", "universal"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64", "universal"]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "LightShare-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "rpm",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        }
      ],
      "maintainer": "Tanmaya Mahapatra <dronalabs.support@gmail.com>",
      "category": "Utility",
      "artifactName": "LightShare-Linux-${arch}.${ext}"
    }
  }
}
